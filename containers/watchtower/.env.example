# Watchtower Environment Variables
# Copy this file to .env and fill in your actual values

# Notification target — Shoutrrr smtp:// URL.
# URL-encode any reserved characters in the username/password (e.g. space -> %20,
# / -> %2F, @ -> %40). Spaces matter: Watchtower reads this variable as a
# space-separated list of URLs, so an unencoded space splits it into garbage.
NOTIFICATION_URL=smtp://user%40example.com:your-app-password@smtp.example.com:587/?fromaddress=your-email%40example.com&toaddresses=your-email%40example.com

# Docker network subnet (overrides the compose default; set via host_vars docker_networks)
WATCHTOWER_NETWORK_SUBNET=172.25.0.0/24
