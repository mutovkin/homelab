# Ignore everything under .claude/ except shared, version-controlled config
.claude/*
!.claude/settings.json
!.claude/skills
.claude/skills/*
!.claude/skills/homelab-change-loop
!.claude/skills/orchestrator

# ZCode per-session plan artifacts (local scratch, never committed)
.zcode/plans/

# Ansible
.vault_password
*.retry
.ansible/

# Rendered service secrets — templated onto hosts at deploy time, never committed
*.env
.env

# Local scratch — temporary notes, dumps, and working files (never committed)
.local-notes/

# OS
.DS_Store

# Database dumps/backups never belong in the repo (backups/ was in the old
# containers/.gitignore; *.sql guards stray dumps — tracked SQL is templated
# as .sql.j2, so plain .sql in the tree is always a secret-bearing dump)
backups/
*.sql

__pycache__/
# HA /api/states snapshots carry personal home-state data (#171).
# scripts/reconcile-ha-entities.py refuses to write one inside a git
# work tree; this is the second line of defence.
ha-states*.json
