# Ignore everything under .claude/ except shared, version-controlled config
.claude/*
!.claude/settings.json
!.claude/skills
.claude/skills/*
!.claude/skills/homelab-change-loop
!.claude/skills/orchestrator

# Ansible
.vault_password
*.retry
ansible/.ansible/

# Rendered service secrets — templated onto hosts at deploy time, never committed
*.env
.env

# Local scratch — temporary notes, dumps, and working files (never committed)
.local-notes/

# OS
.DS_Store

# Portainer-era local residue: untracked plaintext .env files and DB dumps still
# sit under containers/ on operator machines. All TRACKED content moved to
# ansible/roles/services/*/ (#85); without this ignore the leftovers would surface
# in git status one `git add -A` away from a public repo. Purging the files (and
# then this line) is #92.
containers/

# Database dump/backup directories never belong in the repo (was in the old
# containers/.gitignore)
backups/
