# Managed by Ansible (roles/services/musicbrainz) — do not edit on the host.
# No secrets here: this mirror carries only public MusicBrainz data and takes no
# MetaBrainz replication token (static dump, see the role's tasks). That is why
# this template task, unlike every other .env in this repo, does NOT set
# diff: false — there is nothing to redact and the diff is useful.

# Makes upstream's own admin/ scripts and any bare `docker compose` in this
# directory load our override too.
COMPOSE_FILE=docker-compose.yml:compose.homelab.yaml

# Advertised host/port for URLs the server generates. The published port binds
# on all interfaces (upstream leaves MUSICBRAINZ_DOCKER_HOST_IPADDRCOL empty).
MUSICBRAINZ_WEB_SERVER_HOST={{ ansible_host }}
MUSICBRAINZ_WEB_SERVER_PORT={{ musicbrainz_web_port }}
