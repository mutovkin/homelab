# Managed by Ansible (services/navidrome role, #342).
[Unit]
Description=Heal the navidrome stack once both TrueNAS NFS exports are served
# Docker must be up so `docker compose up` works; network must be online so the
# host-only vmbr2 path to TrueNAS exists before we start probing NFS.
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/navidrome-nfs-heal.sh

[Install]
WantedBy=multi-user.target
