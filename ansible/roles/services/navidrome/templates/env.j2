# Navidrome — templated by Ansible (#342)
#
# Every value is single-quoted, deliberately (#117). Compose's dotenv parser
# interpolates $VAR inside UNQUOTED values, so any value containing a `$` is
# silently truncated rather than rejected. Single-quoted values are taken
# literally and are not re-expanded by the compose file's ${VAR} interpolation.
# Caveat: Jinja emits values unescaped, so a value containing `'` would close the
# quote early — tasks/main.yml asserts the vaulted key contains none.
# Reference impl: roles/services/vaultwarden/templates/env.j2
TIMEZONE='{{ timezone }}'
NAVIDROME_UID='{{ navidrome_uid }}'
NAVIDROME_GID='{{ navidrome_gid }}'
NAVIDROME_PORT='{{ navidrome_port }}'
NAVIDROME_DATA_DIR='{{ navidrome_data_dir }}'
NAVIDROME_BACKUP_DIR='{{ navidrome_backup_dir }}'
NAVIDROME_SCAN_SCHEDULE='{{ navidrome_scan_schedule }}'
NAVIDROME_BACKUP_SCHEDULE='{{ navidrome_backup_schedule }}'
NAVIDROME_BACKUP_COUNT='{{ navidrome_backup_count }}'
NAVIDROME_TRANSCODING_MAX_CONCURRENT='{{ navidrome_transcoding_max_concurrent }}'
NAVIDROME_PASSWORD_ENCRYPTION_KEY='{{ vault_navidrome_password_encryption_key }}'
# Last.fm application credentials (scrobbling is then enabled per user in Personal settings)
NAVIDROME_LASTFM_APIKEY='{{ vault_navidrome_lastfm_api_key }}'
NAVIDROME_LASTFM_SECRET='{{ vault_navidrome_lastfm_secret }}'
NAVIDROME_NFS_ADDR='{{ truenas_hostonly_ip }}'
NAVIDROME_NFS_LOSSLESS_EXPORT='{{ navidrome_nfs_exports.lossless }}'
NAVIDROME_NFS_COMPRESSED_EXPORT='{{ navidrome_nfs_exports.compressed }}'
# Docker network subnet (single source of truth: host_vars docker_networks)
NAVIDROME_NETWORK_SUBNET='{{ docker_networks.navidrome | mandatory('docker_networks.navidrome must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
