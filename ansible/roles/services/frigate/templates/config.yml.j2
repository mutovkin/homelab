---
# Frigate configuration — MANAGED BY ANSIBLE.
# Source: ansible/roles/services/frigate/templates/config.yml.j2
#
# Do NOT edit this file on the host, and do not edit it through Frigate's built-in
# config editor: the next deploy overwrites it and restarts the container. Change
# the template (or `frigate_cameras` in host_vars) and deploy instead. Before this
# existed the entire camera configuration lived only on the host and would have been
# lost on a rebuild — the bind-mounted-config gotcha (#91).
#
# Camera credentials are NOT in this file. Frigate substitutes environment variables
# whose names begin with FRIGATE_ at load time, so stream URLs carry the literal
# placeholder {FRIGATE_RTSP_PASSWORD} and the secret stays in the vault-rendered .env.

mqtt:
  # No broker on this fleet. Frigate runs standalone; enable this only alongside a
  # real MQTT service (Home Assistant's, on the HA VM).
  enabled: false

detectors:
  # CPU detection: no Coral/TPU on the N5 Pro. The GPU is used for DECODING via
  # VAAPI (below), which is the expensive half; object detection stays on the CPU.
  cpu1:
    type: cpu

ffmpeg:
  # AMD 890M iGPU passed into CT 201 as /dev/dri (see docs/n5pro.md).
  hwaccel_args: preset-vaapi

detect:
  enabled: true

record:
  enabled: true
  retain:
    days: {{ frigate_record_retain_days }}
    mode: motion

snapshots:
  enabled: true
  retain:
    default: {{ frigate_record_retain_days }}

cameras:
{% for name, cam in frigate_cameras | dictsort %}
  {{ name }}:
    ffmpeg:
      inputs:
        - path: "{{ cam.stream_url }}"
          roles:
            - detect
            - record
{% if cam.detect is defined %}
    detect:
      width: {{ cam.detect.width }}
      height: {{ cam.detect.height }}
{% endif %}
    objects:
      track:
{% for obj in cam.objects | default(['person']) %}
        - {{ obj }}
{% endfor %}
{% endfor %}
