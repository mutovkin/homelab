# Frigate — templated by Ansible from vault variables
FRIGATE_RTSP_PASSWORD={{ vault_frigate_rtsp_password }}
TIMEZONE={{ timezone }}
FRIGATE_CONFIG_DIR={{ data_mount }}/frigate/config
FRIGATE_RECORDINGS_DIR={{ data_mount }}/frigate/recordings
FRIGATE_NETWORK_SUBNET={{ docker_networks.frigate | mandatory('docker_networks.frigate must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}
