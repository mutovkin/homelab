# Frigate — templated by Ansible from vault variables
#
# Every value is single-quoted, deliberately (#117). Compose's dotenv parser
# interpolates $VAR inside UNQUOTED values, so any value containing a `$` is
# silently truncated rather than rejected. Single-quoted values are taken
# literally and are not re-expanded by the compose file's ${VAR} interpolation.
# Caveat: Jinja emits values unescaped, so a value containing `'` would close the
# quote early and compose aborts loudly — such a value needs a different
# transport. None do today. Reference impl: roles/services/vaultwarden/templates/env.j2
FRIGATE_RTSP_PASSWORD='{{ vault_frigate_rtsp_password }}'
TIMEZONE='{{ timezone }}'
FRIGATE_CONFIG_DIR='{{ data_mount }}/frigate/config'
FRIGATE_RECORDINGS_DIR='{{ data_mount }}/frigate/recordings'
FRIGATE_NETWORK_SUBNET='{{ docker_networks.frigate | mandatory('docker_networks.frigate must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
