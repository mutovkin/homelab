[Unit]
Description=Vaultwarden HTTP firewall (Ansible-managed nftables table inet vaultwarden_fw)
# Boot: load after the stock nftables.service (its `flush ruleset` would wipe us);
# publish the rules before docker starts exposing ports.
After=nftables.service
Before=docker.service
# A runtime restart of nftables.service also flushes this table; PartOf makes
# that restart re-run this unit (After= orders us behind the flush), re-loading it.
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/vaultwarden-firewall.nft
ExecStop=-/usr/sbin/nft delete table inet vaultwarden_fw

[Install]
WantedBy=multi-user.target
