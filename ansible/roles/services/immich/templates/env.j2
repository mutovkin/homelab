# Immich — templated by Ansible from vault variables
IMMICH_DB_USERNAME={{ vault_immich_db_username | default('immich') }}
IMMICH_DB_PASSWORD={{ vault_immich_db_password }}
IMMICH_DB_DATABASE={{ vault_immich_db_database | default('immich') }}
UPLOAD_LOCATION={{ data_mount }}/immich/upload
IMMICH_NETWORK_SUBNET={{ docker_networks.immich | mandatory('docker_networks.immich must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}
