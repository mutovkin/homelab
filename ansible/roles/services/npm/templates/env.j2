{# Nginx Proxy Manager (#331). No secrets here: NPM's own credentials (admin login, the
   DNS-provider token) live in its database, migrated as data, never templated. #}
NPM_DATA_DIR='{{ npm_data_dir }}'
NPM_NETWORK_SUBNET='{{ docker_networks.npm | mandatory('docker_networks.npm must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
TIMEZONE='{{ timezone | default('UTC') }}'
