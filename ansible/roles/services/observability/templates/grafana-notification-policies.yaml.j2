apiVersion: 1

# Grafana file-provisioned alerting — root notification policy (#139)
#
# Without this, every rule in this folder routed to Grafana's stock
# `grafana-default-email` receiver, whose address is the literal placeholder
# `<example@email.com>`. A rule wired to that is indistinguishable from a rule
# wired to nothing — which is the defect #139 is about, one layer up from the
# missing rules themselves.
#
# The receiver is provisioned from templates/grafana-contact-points.yaml.j2 (the
# address is a vault value, so it cannot be a static file in this repo).
#
# SCOPE, stated precisely because the wording here used to be wrong: a `policies:`
# entry with no `routes:` is the ROOT route for the whole ORG, not for one folder.
# Every rule in every folder inherits `homelab-email` — including #108's existing
# rule, which is exactly why this wires it up. It is org-wide on purpose; do NOT
# add a folder matcher to "scope" it, that would orphan every rule outside the
# folder back to the stub receiver.
#
# WHY THIS IS NOW A TEMPLATE (#152): the routing tree branches on
# observability_alert_telegram, and a static file cannot. Consequence, and it must
# not be undone: the "Deploy Grafana provisioning" synchronize runs with
# delete:true over this directory, so it carries
# `--exclude=alerting/notification-policies.yaml`. Remove that exclude and rsync
# deletes this file every run while the template writes it back — Grafana would
# restart on every deploy, forever. Same mechanism and same precedent as
# contact-points.yaml. No secrets render here (receiver NAMES only), so unlike
# contact-points this task needs no diff:false.
#
# NOTE: a provisioned root policy is READ-ONLY in the Grafana UI, so this file is
# now the only editable source of routing. Editing it means editing this file and
# re-running the deploy. Before this
# landed, the root policy was Grafana's stock default and nothing hand-made
# existed here — verified against /api/v1/provisioning/policies immediately
# before the first apply. If someone later builds routing in the UI, this file
# will replace it.
policies:
  - orgId: 1
    receiver: homelab-email
    # `server` is in group_by on purpose: the probe rules (#139) carry one
    # instance per probed URL, and without it two different services failing
    # would be merged into ONE notification whose subject names only the first.
    #
    # `hostname` is here for exactly the same reason, added by #134:
    # obs-host-log-ingest-stalled-per-host carries one instance per HOST, and its
    # entire purpose is to say WHICH host stopped shipping. Without this key, two
    # dead shippers collapse into a single `[FIRING:2]` notification whose subject
    # names neither, which would make the rule no better than the fleet-wide one
    # it exists to supplement.
    #
    # Adding a label that most rules do not carry is safe and is already the
    # established pattern here: `server` is absent from both log-ingest rules and
    # they group fine. Alertmanager simply treats the missing label as empty for
    # grouping purposes.
    # `component_id` joins them for #151: the vector-health rules carry one
    # instance per Vector component, and without it two different components
    # discarding events would collapse into one notification naming neither.
    #
    # `integration` joins them for #152, on identical grounds:
    # obs-alert-delivery-failing carries one instance per integration, and its
    # whole subject line is WHICH channel failed. Without this key an email
    # failure and a telegram failure — the case where you most need to know which
    # is which — merge into one `[FIRING:2]` naming neither. It is also what makes
    # the A5 routing split below observable: the two instances take different
    # routes and must not be grouped back together first.
    group_by:
      - grafana_folder
      - alertname
      - server
      - hostname
      - component_id
      - integration
      # `devname` is the TrueNAS thermal rules' per-drive label (#176 added this
      # key as `disk`; #174 repointed the rules at the API poller, whose label is
      # `devname`, and the key silently went inert — group_by on a label no
      # instance carries is a no-op, so two drives crossing 47C together merged
      # into one [FIRING:2] naming neither, #188). The whole point of the key is
      # WHICH disk is hot. Fix drift here, in the POLICY — never by rewriting the
      # rule exprs to match this file, which would empty every
      # $labels.devname interpolation in the summaries. (Brace-free on purpose:
      # this is a Jinja template, and the real interpolations carry braces.)
      - devname
      # `pool` for the same reason (#188): truenas-pool-degraded and
      # truenas-scrub-overdue carry one instance per pool.
      - pool
    # 30s: long enough to batch instances of the same rule that trip together,
    # short enough that a real outage is not sat on.
    group_wait: 30s
    group_interval: 5m
    # 12h: these are homelab alerts on a mailbox a human reads, not a pager.
    repeat_interval: 12h
    routes:
{% if observability_alert_telegram | bool %}
      # ORDER MATTERS TWICE OVER: first match wins, there is no `continue` on any
      # of these, and the two routes below are a MATCHED PAIR that must stay in
      # this order.
      #
      # The principle (#152): an alert reporting that a channel failed must not
      # travel BY that channel. `channel=telegram-only` on the delivery-failure
      # rule means "route me off the failing channel" — the label name is
      # historical and predates this pair.
      #
      # So the more specific matcher goes first: a TELEGRAM delivery failure is
      # reported by EMAIL. Without it, the single route below would have sent a
      # "telegram is broken" page through telegram — reintroducing, for the
      # telegram half, exactly the defect #152 removed for the email half.
      - receiver: homelab-email
        object_matchers:
          - ["channel", "=", "telegram-only"]
          - ["integration", "=", "telegram"]
      # Everything else carrying that label — in practice integration=email —
      # goes by Telegram. This is the original #152 route and must stay SECOND;
      # promoted above the pair it would swallow the telegram case.
      - receiver: homelab-telegram
        object_matchers:
          - ["channel", "=", "telegram-only"]
{% endif %}
      # The daily delivery heartbeat (#152). It fires forever by design and
      # re-notifies every 24h on the both-channels receiver. Silence on a channel
      # past 24h IS that channel's failure signal — the heartbeat is the monitor,
      # a human noticing its absence is the alarm, and neither depends on the
      # broken channel being able to report itself. repeat_interval is the
      # delivery cadence, so it belongs on this route and not on the root (the
      # root's 12h governs every ordinary alert and must not be dragged around by
      # the heartbeat).
      - receiver: homelab-critical
        object_matchers:
          - ["heartbeat", "=", "true"]
        repeat_interval: 24h
      # TrueNAS thermal warnings (#176) page on both channels DESPITE being
      # severity=warning. The operator asked to be told immediately when a disk
      # crosses 47C, and the root receiver is email-only — a warning that waits
      # for someone to check mail does not meet that. The alternative was to
      # label a 47C early-warning `critical`, which would have made severity
      # stop meaning anything on the one dimension it is read for.
      #
      # Narrow BY DESIGN: it matches the component, not the severity, so it
      # cannot quietly promote every future warning in the fleet to a page.
      # Placed BEFORE the severity=critical route only for readability — the two
      # cannot both match, since this one requires severity=warning.
      - receiver: homelab-critical
        object_matchers:
          - ["component", "=", "nas-thermal"]
          - ["severity", "=", "warning"]
      # Critical rules page on BOTH channels once Telegram exists. homelab-critical
      # degrades to email-only while it does not (see the contact-points
      # template), which is why this route renders unconditionally — a route to a
      # receiver that does not exist is a fatal provisioning error, and this shape
      # means it can never dangle.
      - receiver: homelab-critical
        object_matchers:
          - ["severity", "=", "critical"]
