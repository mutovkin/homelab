#!/usr/sbin/nft -f
# Managed by Ansible (roles/services/observability) — restricts the VictoriaMetrics
# InfluxDB ingest port (tcp+udp {{ observability_firewall.ports | join(', ') }}) to
# approved sources (#122).
#
# Why this port and not the others: :8089 is an UNAUTHENTICATED write endpoint.
# VictoriaMetrics' --httpAuth.* only guards the :8428 HTTP API; the InfluxDB
# listener enabled by --influxListenAddr accepts line-protocol writes from anyone
# who can reach it, over TCP *and* UDP. Its only intended client is the Home
# Assistant VM. :8428 (read/query, authenticated), :9428 and :3000 stay untouched —
# NPM (192.168.25.20) and operator workstations must keep reaching them.
#
# Docker DNATs published ports in PREROUTING (its dstnat chain, priority -100).
# DNAT'd flows are rewritten to the container IP and take FORWARD — an input-hook
# chain never sees them; only residual docker-proxy traffic reaches INPUT (still on
# the original port). PREROUTING before dstnat (-100) is the one place both paths
# are visible on the original dport, so this table hooks prerouting at -150.
#
# Fail-open by construction
# (docs/solutions/conventions/scoped-nftables-on-live-host.md): single-purpose
# table, policy accept, every non-target packet exits on the first two rules, only
# the target dports are ever dropped, and unloading the table (ExecStop, a stray
# `flush ruleset` from the stock nftables.service) leaves the port OPEN — never the
# host unreachable.
#
# The allowlist is IPv4-only. Docker also publishes the port on [::], so the final
# drop rules match IPv6 too and all external IPv6 access to it is dropped by design
# (::1 arrives via "lo" and is accepted). Add `ip6 saddr` accepts above the drops if
# an IPv6 writer is ever needed.
add table inet observability_fw
delete table inet observability_fw
table inet observability_fw {
  chain prerouting {
    type filter hook prerouting priority -150; policy accept;
    # FIRST + terminal, one per transport: every TCP packet not aimed at a governed
    # port exits on rule 1, every UDP packet not aimed at one exits on rule 2 (each
    # rule carries an implicit l4proto dependency, so the other transport simply does
    # not match). Anything that is neither TCP nor UDP matches no rule in this chain
    # at all and lands on the policy accept — fail-open in every direction.
    tcp dport != { {{ observability_firewall.ports | join(', ') }} } accept
    udp dport != { {{ observability_firewall.ports | join(', ') }} } accept
    # In scope only when addressed to this host: at -150 daddr is still the host's
    # own address (pre-DNAT), while container egress, east-west bridged frames
    # (br_netfilter puts them through this hook) and any other forwarded flow to some
    # external :{{ observability_firewall.ports | join('/') }} is non-local and exits here.
    fib daddr type != local accept
    iif "lo" accept
    ip saddr 127.0.0.1 accept
    # Hairpin: a local container reaching the published port via the host address
    # arrives on a docker bridge interface, never on the LAN iface. Scoping the accept
    # by interface means a LAN packet with a FORGED 172.16/12 source still arrives on
    # {{ observability_firewall.lan_iface }} and falls through to the allowlist/drop below.
    iifname != "{{ observability_firewall.lan_iface }}" ip saddr 172.16.0.0/12 accept
{% for src in observability_firewall.allowed_sources %}
    ip saddr {{ src }} accept
{% endfor %}
    # Any other source reaching the ingest port is dropped, TCP and UDP, v4 and v6.
    tcp dport { {{ observability_firewall.ports | join(', ') }} } drop
    udp dport { {{ observability_firewall.ports | join(', ') }} } drop
  }
}
