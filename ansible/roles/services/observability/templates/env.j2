# Observability Stack — templated by Ansible from vault variables
#
# Every value is single-quoted, deliberately (#117). Compose's dotenv parser
# interpolates $VAR inside UNQUOTED values, so any value containing a `$` is
# silently truncated rather than rejected — the VM/VL/Grafana passwords below are
# exactly the values where a truncated secret means "auth silently weaker than
# configured". Single-quoted values are taken literally and are not re-expanded by
# the compose file's ${VAR} interpolation.
# Caveat: Jinja emits values unescaped, so a value containing `'` would close the
# quote early and compose aborts loudly — such a value needs a different
# transport. None do today. Reference impl: roles/services/vaultwarden/templates/env.j2
TIMEZONE='{{ timezone }}'
{# No fallback on purpose: the docker gid differs per host (996 on deb-docker,
   990 on n5pro-docker) and the old '999' default existed on neither, so a
   fallback could only ever hand telegraf a group that cannot read the socket.
   An undefined stat fails this template instead — mandatory()/${VAR:?} precedent. #}
DOCKER_GID='{{ docker_socket_stat.stat.gid }}'
GRAFANA_USER='{{ vault_grafana_user }}'
GRAFANA_PASSWORD='{{ vault_grafana_password }}'
GRAFANA_ROOT_URL='{{ vault_grafana_root_url }}'
GRAFANA_DOMAIN='{{ vault_grafana_domain }}'
VM_AUTH_USERNAME='{{ vault_vm_auth_username }}'
VM_AUTH_PASSWORD='{{ vault_vm_auth_password }}'
VL_AUTH_USERNAME='{{ vault_vl_auth_username }}'
VL_AUTH_PASSWORD='{{ vault_vl_auth_password }}'
{# The hostname label on every Vector log record (#143). get_hostname!() inside the
   container returns the CONTAINER ID — not a host, and it changes on every
   recreate, churning _stream_id in VictoriaLogs and making per-host alerting
   impossible (#134 is built on this label).
   inventory_hostname, deliberately, and NOT the CT's OS hostname (deb-docker):
   the label a per-host alert is written against must be the name the inventory
   uses, or every alert needs a second hand-maintained hostname↔inventory mapping.
   The OS hostname is not lost — it is stored per-record as `syslog_hostname`,
   parsed out of the RFC5424 header. #}
VECTOR_HOSTNAME='{{ inventory_hostname }}'
VM_MEMORY_LIMIT='{{ vm_memory_limit | default('2G') }}'
VL_MEMORY_LIMIT='{{ vl_memory_limit | default('1G') }}'
VECTOR_MEMORY_LIMIT='{{ vector_memory_limit | default('512M') }}'
TELEGRAF_MEMORY_LIMIT='{{ telegraf_memory_limit | default('256M') }}'
GRAFANA_MEMORY_LIMIT='{{ grafana_memory_limit | default('1G') }}'

# Docker network subnet (single source of truth: host_vars docker_networks)
OBSERVABILITY_NETWORK_SUBNET='{{ docker_networks.observability | mandatory('docker_networks.observability must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
