    },
    {
      "type": "timeseries",
      "title": "Atmospheric pressure",
      "description": "A sharp fall usually precedes weather within 6-12 hours.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
