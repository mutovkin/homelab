    {
      "type": "timeseries",
      "title": "Battery trend",
      "description": "A straight decline is normal ageing; a cliff is usually cold or a stuck radio. A line that simply STOPS is the device dying — which is what the age panels quantify.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
