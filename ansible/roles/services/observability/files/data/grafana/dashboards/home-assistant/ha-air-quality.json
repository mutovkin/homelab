            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "PM2.5",
      "description": "Fine particulate. WHO 24h guideline is 15 µg/m³; 35+ is the US 'unhealthy for sensitive groups' band.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
