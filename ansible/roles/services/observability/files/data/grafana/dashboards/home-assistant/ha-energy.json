            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Energy consumed per hour",
      "description": "Hourly delta of the lifetime counter — the shape most people actually want. increase() handles the counter reset that a raw difference would render as a large negative spike.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "increase({__name__=\"kWh_value\"}[1h])",
          "legendFormat": "{{entity_id}}",
          "range": true,
          "instant": false,
          "refId": "A"
