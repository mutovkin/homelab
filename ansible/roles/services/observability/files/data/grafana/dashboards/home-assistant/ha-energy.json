{
  "uid": "ha-energy",
  "title": "Home Assistant — Energy",
  "description": "Power draw and consumption for the monitored circuits.",
  "tags": [
    "home-assistant",
    "energy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Current draw (all monitored)",
      "description": "Sum of every power-reporting plug/switch. This is NOT whole-home draw — only the monitored circuits.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "sum(last_over_time({__name__=\"W_value\"}[1h]))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "orange",
                "value": 1500
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Power by device",
      "description": "Latest wattage per monitored device.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "last_over_time({__name__=\"W_value\"}[1h])",
          "legendFormat": "{{entity_id}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "max": 2000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "sizing": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Power draw over time",
      "description": "Instantaneous watts. The duty-cycle pattern of a bathroom fan or a fridge compressor is clearly readable here.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
