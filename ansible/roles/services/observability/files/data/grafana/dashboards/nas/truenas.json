    {
      "type": "stat",
      "title": "Days since scrub",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 10,
        "y": 8,
        "w": 5,
        "h": 5
      },
      "description": "A scrub is what detects silent corruption before it is read back. Thresholds match #176's overdue rule (35 days), which is set above the monthly schedule so ordinary jitter does not fire it.",
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "max(truenas_pool_scrub_age_seconds{host=\"truenas\"}) / 86400",
          "legendFormat": "days",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
