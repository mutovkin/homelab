{
  "uid": "nas-truenas",
  "title": "NAS \u2014 TrueNAS",
  "description": "TrueNAS (VM 200) storage and system health. Disk temperatures, pool health, capacity and scrub state come from the JSON-RPC API poller (#174); ARC, CPU, memory and disk I/O from the netdata Graphite stream (#173). SMART attribute counters are not yet collected.",
  "tags": [
    "nas",
    "truenas",
    "storage"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Disk health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Hottest HDD",
      "description": "Maximum temperature across the spinning disks. Scoped by media=\"hdd\", which #174's poller derives from ROTATION RATE rather than the API's `type` field \u2014 the QEMU virtual boot disk reports type=HDD with no rotation rate and no SMART, and its temperature reads as a fabricated 0. Thresholds are the #176 alert thresholds exactly, so panel and alert can never disagree.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "max(truenas_disk_temperature_celsius{host=\"truenas\", media=\"hdd\"})",
          "legendFormat": "hottest",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 47
              },
              {
                "color": "red",
                "value": 52
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk temperature",
      "description": "Per-device temperature from the TrueNAS API (#174), keyed by real device name and polled every 60s \u2014 dense, unlike the Graphite stream's sparse, serial-keyed series. Disks with no SMART (the virtual boot disk) are absent rather than reported as 0: the poller skips unknown gauges instead of zeroing them, because a fabricated reading is worse than a gap.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "truenas_disk_temperature_celsius{host=\"truenas\"}",
          "legendFormat": "{{devname}} ({{media}})",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": 600000
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
