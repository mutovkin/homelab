{
  "uid": "nas-truenas",
  "title": "NAS \u2014 TrueNAS",
  "description": "TrueNAS (VM 200) storage and system health. PROVISIONAL (#175): built only on metrics the Graphite stream actually delivers. Pool capacity, pool HEALTH, scrub state, SMART counters, network throughput and system load are all absent from this source on TrueNAS 26.0 \u2014 measured, not assumed \u2014 and arrive with #174's API poller. Drives are identified by SERIAL here; #174 adds real device names.",
  "tags": [
    "nas",
    "truenas",
    "storage"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Disk health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Hottest HDD",
      "description": "Maximum temperature across the five 26TB Exos drives. The NVMe are excluded deliberately \u2014 they run to 60-70C by design, so including them would either hide a hot HDD or make the thresholds meaningless. Thresholds match the #176 alert rules exactly: 47C warning, 52C critical. last_over_time is required: this series updates every few MINUTES, so an instant read shows No data between samples.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "max(last_over_time(truenas_disk_temp_temp{host=\"truenas\", disk=~\"_serial_lunid_(ZXA07GGS|ZXA02DNC|ZXA19LRP|ZXA1Q6VK|ZXA02XYW)_.*\"}[30m]))",
          "legendFormat": "hottest",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 47
              },
              {
                "color": "red",
                "value": 52
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk temperature",
      "description": "Per-drive temperature. Serials ZXA* are the five 26TB Exos HDDs; 25370Y8* are the two SN850X NVMe. _devicename_sda is EXCLUDED by the selector: the virtual boot disk has no SMART and netdata reports its temperature as 0, not null \u2014 a fabricated zero that would drag this panel's floor down and make the array look colder than it is. spanNulls is set to 1h because the series is sparse (minutes between samples); without it every line would be drawn as disconnected dots.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "label_replace(last_over_time(truenas_disk_temp_temp{host=\"truenas\", disk=~\"_serial_lunid_.*\"}[30m]), \"drive\", \"$1\", \"disk\", \"_serial_lunid_([^_]+)_.*\")",
          "legendFormat": "{{drive}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": 3600000
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
