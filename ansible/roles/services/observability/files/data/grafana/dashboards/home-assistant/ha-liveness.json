{
  "uid": "ha-liveness",
  "title": "Home Assistant — Device Liveness (which devices stopped working)",
  "description": "Seconds since each entity's last real sample. The view HA's own last_updated cannot give you, because it resets to boot time on every restart.",
  "tags": [
    "home-assistant",
    "liveness",
    "maintenance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Silent > 24h",
      "description": "Entities whose most recent REAL sample is over a day old. Some are legitimately quiet (a door nobody opened); the ones that should be chatty are the finding. (Reads 0 rather than \"No data\" when nothing qualifies — an empty result on a health counter is indistinguishable from a broken query.)",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "count(lag({__name__=~\".*_value\", db=\"ha\"}[30d]) > 86400) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 52
        }
      }
    },
    {
      "type": "stat",
      "title": "Silent > 3 days",
      "description": "Three days of silence from a sensor that normally reports is a strong signal it has stopped working. (Reads 0 rather than \"No data\" when nothing qualifies — an empty result on a health counter is indistinguishable from a broken query.)",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "count(lag({__name__=~\".*_value\", db=\"ha\"}[30d]) > 259200) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 52
        }
      }
    },
    {
      "type": "stat",
      "title": "Silent > 7 days",
      "description": "Almost certainly dead: flat battery, dropped off the mesh, or unpaired. This is the number to drive to zero. (Reads 0 rather than \"No data\" when nothing qualifies — an empty result on a health counter is indistinguishable from a broken query.)",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "count(lag({__name__=~\".*_value\", db=\"ha\"}[30d]) > 604800) or vector(0)",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 52
        }
      }
    },
    {
      "type": "stat",
      "title": "Entities reporting",
      "description": "Total entities that have produced at least one sample in the last 30 days.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "count(lag({__name__=~\".*_value\", db=\"ha\"}[30d]))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
