        },
        "text": {
          "valueSize": 52
        }
      }
    },
    {
      "type": "table",
      "title": "Every entity by silence — stalest first",
      "description": "THE panel. Seconds since each entity's last real sample, worst at the top. This is what HA cannot tell you: its last_updated is rewritten to boot time on every restart, so a device that died in March looks freshly updated after a reboot. These timestamps come from the samples themselves and survive restarts.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 14,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "lag({__name__=~\".*_value\", db=\"ha\"}[30d])",
          "legendFormat": "{{entity_id}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "db": true,
              "domain": true
            },
            "renameByName": {
              "entity_id": "Entity",
              "Value": "Value"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "orange",
                "value": 259200
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "countRows": false,
          "reducer": [
            "sum"
          ]
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Samples in the last 24h (low = suspicious)",
      "description": "A cross-check on the table. A device reporting once or twice a day may be dying rather than idle — compare against how chatty it used to be.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 14,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "count_over_time({__name__=~\".*_value\", db=\"ha\"}[24h])",
          "legendFormat": "{{entity_id}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "sizing": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Silence creeping up (top offenders)",
      "description": "Ten stalest entities over time. A line climbing at 45° is a device that stopped and never came back — the slope IS the silence. A sawtooth is a device reporting normally on a slow cycle.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "P4169E866C3094E38"
          },
          "editorMode": "code",
          "expr": "topk(10, lag({__name__=~\".*_value\", db=\"ha\"}[30d]))",
          "legendFormat": "{{entity_id}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
