#!/usr/sbin/nft -f
# Managed by Ansible (roles/services/postgresql) — restricts the published
# PostgreSQL/pgAdmin ports to approved sources (#79).
#
# Docker DNATs published ports in PREROUTING (its dstnat chain, priority -100).
# DNAT'd flows are rewritten to the container IP and take FORWARD — an
# input-hook chain never sees them; only residual docker-proxy traffic reaches
# INPUT (still on the original port). PREROUTING before dstnat (-100) is the
# one place both paths are visible on the original dport, so this table hooks
# prerouting at priority -150.
#
# Fail-open by construction
# (docs/solutions/conventions/scoped-nftables-on-live-host.md): single-purpose
# table, policy accept, every non-target TCP packet exits on the first rule
# (nft gives that rule an implicit l4proto tcp dependency, so non-TCP traffic
# simply falls through to the policy accept — fail-open either way), only the
# target dports are ever dropped, and unloading the table (ExecStop, stray
# flush) leaves the ports OPEN — never the host unreachable.
#
# The allowlist is IPv4-only. Docker also publishes these ports on [::] and the
# host has a LAN-routable ULA (fd…, `scope global` in ip addr), so IPv6 traffic
# to these ports is dropped wholesale below; add `ip6 saddr` accepts above that
# rule if an IPv6 client is ever needed.
add table inet postgres_fw
delete table inet postgres_fw
table inet postgres_fw {
  chain prerouting {
    type filter hook prerouting priority -150; policy accept;
    # FIRST + terminal: every TCP packet not aimed at the published ports exits
    # here (non-TCP never matches and falls through to the policy accept).
    tcp dport != { {{ postgres_firewall.ports | join(', ') }} } accept
    iif "lo" accept
    # br_netfilter is enabled (docker), so bridged container<->container frames
    # traverse this hook too — anything not addressed to the host's LAN address
    # (e.g. joplin -> postgres on 172.21.0.0/24) is out of scope.
    ip daddr != {{ postgres_firewall.host_addr }} accept
    ip saddr 127.0.0.1 accept
    # Hairpin: a local container reaching a published port via the host address
    # arrives on a docker bridge interface, never on the LAN iface. Scoping the
    # accept by interface means a LAN packet with a FORGED 172.16/12 source
    # arrives on {{ postgres_firewall.lan_iface }} and falls through to the allowlist/drop below.
    iifname != "{{ postgres_firewall.lan_iface }}" ip saddr 172.16.0.0/12 accept
{% for src in postgres_firewall.allowed_sources %}
    ip saddr {{ src }} accept
{% endfor %}
    # No IPv6 allowlist: drop the published ports over IPv6 entirely.
    meta nfproto ipv6 tcp dport { {{ postgres_firewall.ports | join(', ') }} } drop
    # Any other source reaching the published ports is dropped.
    ip daddr {{ postgres_firewall.host_addr }} tcp dport { {{ postgres_firewall.ports | join(', ') }} } drop
  }
}
