# Watchtower — templated by Ansible from vault variables
#
# Every value is single-quoted, deliberately (#117). Compose's dotenv parser
# interpolates $VAR inside UNQUOTED values, so any value containing a `$` is
# silently truncated rather than rejected. Single-quoted values are taken
# literally and are not re-expanded by the compose file's ${VAR} interpolation.
# Caveat: Jinja emits values unescaped, so a value containing `'` would close the
# quote early and compose aborts loudly — such a value needs a different
# transport. None do today (the NOTIFICATION_URL parts below are urlencoded, and
# urlencode escapes `'` to %27). Reference impl:
# roles/services/vaultwarden/templates/env.j2
WATCHTOWER_SCHEDULE='{{ watchtower_schedule }}'
WATCHTOWER_TIMEZONE='{{ watchtower_timezone }}'
# Shoutrrr smtp:// notification URL (replaces the deprecated legacy email options).
# urlencode leaves "/" untouched, so it is escaped explicitly — an unescaped "/" in
# the password would terminate the URL authority and silently break SMTP auth.
NOTIFICATION_URL='smtp://{{ vault_watchtower_email_user | urlencode | replace('/', '%2F') }}:{{ vault_watchtower_email_password | urlencode | replace('/', '%2F') }}@{{ vault_watchtower_email_server }}:{{ vault_watchtower_email_port }}/?fromaddress={{ vault_watchtower_email_from | urlencode }}&toaddresses={{ vault_watchtower_email_to | urlencode }}'

# Docker network subnet (single source of truth: host_vars docker_networks)
WATCHTOWER_NETWORK_SUBNET='{{ docker_networks.watchtower | mandatory('docker_networks.watchtower must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
