# SearXNG — templated by Ansible from vault variables
#
# Every value is single-quoted, deliberately (#117). Compose's dotenv parser
# interpolates $VAR inside UNQUOTED values, so any value containing a `$` is
# silently truncated rather than rejected — SEARXNG_SECRET is exactly the kind of
# random value that eventually contains one. Single-quoted values are taken
# literally and are not re-expanded by the compose file's ${VAR} interpolation.
# Caveat: Jinja emits values unescaped, so a value containing `'` would close the
# quote early and compose aborts loudly — such a value needs a different
# transport. None do today. Reference impl: roles/services/vaultwarden/templates/env.j2
SEARXNG_HOSTNAME='{{ vault_searxng_hostname }}'
SEARXNG_SECRET='{{ vault_searxng_secret }}'

# Docker network subnet (single source of truth: host_vars docker_networks)
SEARXNG_NETWORK_SUBNET='{{ docker_networks.searxng | mandatory('docker_networks.searxng must be pinned in host_vars — see the fleet map in host_vars/n5pro_docker/vars.yml') }}'
