# Managed by Ansible (roles/truenas_poller) — DO NOT EDIT ON THE HOST.
#
# SECRET-BEARING: contains the TrueNAS API key and the VictoriaMetrics
# credential. Its deploy task sets mode 0600 and `diff: false` (#88), so the file
# reports changed without ever rendering its content into the log.
TRUENAS_API_URL={{ truenas_poller_api_url }}
TRUENAS_API_KEY={{ truenas_poller_api_key }}
TRUENAS_HOST_LABEL={{ truenas_poller_host_label }}

# The import endpoint, reached over LOOPBACK on this host. VictoriaMetrics
# publishes :8428 here, and the scoped nftables table already accepts `iif lo`
# and 127.0.0.1 — so this path needs no allowlist entry of its own, and the
# credential never crosses the LAN.
VM_IMPORT_URL={{ truenas_poller_vm_url }}
VM_AUTH_USERNAME={{ vault_vm_auth_username }}
VM_AUTH_PASSWORD={{ vault_vm_auth_password }}
