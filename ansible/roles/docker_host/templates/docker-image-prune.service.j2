# {{ ansible_managed }} — roles/docker_host (#316)
# -> /etc/systemd/system/docker-image-prune.service
#
# Removes DANGLING images only (untagged and unused): superseded watchtower
# candidates and the previous image of a service a deploy has moved past.
# Tagged images — including a candidate watchtower has pulled but nobody has
# deployed yet — are never touched, so adopting it later re-downloads nothing.
# An image a container still runs is refused by docker itself. Volumes, networks,
# containers and build cache are out of scope. Same scope as tasks/prune.yml.
#
# Triggered by docker-image-prune.timer; not enabled on its own.

[Unit]
Description=Prune dangling docker images (superseded pulls)
After=docker.service
# Requisite, not Requires: housekeeping must never START docker. Note what a
# missed run looks like if dockerd is down: the job ends with result
# `dependency`, the unit stays inactive (not `failed`), and the journal gets a
# "Dependency failed" line — dockerd being down is caught by every other alert.
Requisite=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune --force --filter dangling=true
# A oneshot has no start timeout by default; a hung dockerd would leave this unit
# `activating` forever and turn every later timer firing into a silent no-op.
TimeoutStartSec=30min
