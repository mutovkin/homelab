# {{ ansible_managed }} — roles/vector_agent (#134). Do not edit on the host.
#
# THIS IS A systemd EnvironmentFile, NOT a compose dotenv. The two parsers differ
# and the repo's dotenv habit must not be copied here blindly:
#
#   * compose's dotenv INTERPOLATES `$` in an unquoted value, which is why every
#     .env this repo templates SINGLE-quotes its values (#117). systemd does no
#     such interpolation, and it does not strip single quotes the way compose does
#     — a single-quoted value here would arrive with the quotes still attached.
#   * systemd DOES strip a surrounding pair of double quotes and treats the
#     contents literally, including `$`. That is why the values below are
#     double-quoted: it makes leading/trailing whitespace and `#` unambiguous
#     without changing the value.
#
# That sentence is verified rather than trusted: roles/vector_agent/tasks/main.yml
# reads VL_AUTH_PASSWORD back out of the RUNNING process's /proc/<pid>/environ,
# hashes it on the host, and asserts the digest equals the vault value's digest.
# Neither value is ever printed.
#
# NOTHING BUT SYSTEMD MAY PARSE THIS FILE. The pre-flight validate deliberately
# runs it through `systemd-run --property=EnvironmentFile=`, not through a shell.
# Measured on n5pro_docker, feeding the SAME file to both parsers. The value on
# disk was  PROBE_A="lit-dollar-$HOME-and-backtick-<backtick>id<backtick>"  and:
#   systemd -> lit-dollar-$HOME-and-backtick-<backtick>id<backtick>     (literal)
#   bash `.` -> lit-dollar-/root-and-backtick-uid=0(root) gid=0(root)   (EXECUTED)
# The backtick ran, as root. If you ever add a second reader of this file, it must
# use systemd's parser, or the value it sees is not the value Vector gets — and a
# rotated credential could execute.
#
# Read by systemd as the MANAGER (root) before it drops to User=vector, so this
# file is 0600 root:root and the vector user never needs to read it. Do not widen
# the mode "so vector can read it" — that would be a real regression for no gain.
VECTOR_HOSTNAME="{{ inventory_hostname }}"
VL_AUTH_USERNAME="{{ vault_vl_auth_username }}"
VL_AUTH_PASSWORD="{{ vault_vl_auth_password }}"
# LOAD-BEARING, and the #057 lesson in one line. Vector 0.57 disabled ${VAR}
# interpolation inside config files by default. Without this, Vector sends the
# LITERAL string `${VL_AUTH_USERNAME}` as the username, VictoriaLogs answers 401,
# every batch is dropped — and Vector stays up, RestartCount 0, reporting nothing
# wrong. The log pipeline was dead for ~30 days that way once already. See
# docs/solutions/integration-issues/vector-057-silent-log-pipeline-failure.md.
VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION=true
