# {{ ansible_managed }}
# Vector configuration for the NATIVE (systemd) log shipper — {{ inventory_hostname }} (#134)
#
# THIS FILE IS A DELIBERATE NEAR-DUPLICATE of
# ansible/roles/services/observability/files/data/vector/vector.yaml, which is the
# same pipeline for the CONTAINER on eq12_docker. The record schema both produce is
# documented in ONE place — roles/services/observability/README.md, section
# "Log record schema". CHANGE ONE, CHANGE BOTH, and change the README with them.
#
# FIVE things differ from the container's copy, and they are the only five that
# may differ. This list IS the drift guard — if you add a sixth difference, add it
# here in the same change, or the guard silently stops guarding:
#   1. the sink endpoint is the LAN address of VictoriaLogs, not a compose service
#      name (there is no docker network here);
#   2. the docker_logs source and its parse_docker transform exist only where
#      vector_agent_docker_logs is true;
#   3. this file is templated, so `{{ '{{' }} ... {{ '}}' }}` sink templates have to
#      be escaped from Jinja, and `timezone` comes from a Jinja var rather than
#      from the container's TZ environment variable.
#
#      DO NOT write a dollar-brace env reference in a COMMENT in this file.
#      Vector's env-var interpolation is a textual pre-pass over the whole config
#      and does not skip comments, so a commented-out reference to a variable that
#      is not in /etc/vector/vector.env fails the config LOAD:
#        x Missing environment variable in config. name = "TZ"
#      Measured — an earlier version of this very line mentioned the container's
#      TZ in dollar-brace form and broke all three agents' config load. It was
#      caught by this role's pre-flight `vector validate`, which runs BEFORE the
#      restart, so the agents kept running and nothing was lost; that gate is the
#      only reason this was a failed play rather than three dead shippers.
#      Every dollar-brace reference below is to a variable vector.env really
#      defines (VECTOR_HOSTNAME, VL_AUTH_*);
#   4. NO internal_metrics source and NO prometheus_remote_write sink (#151).
#      Vector's self-telemetry is container-only, so the four obs-vector-* alert
#      rules do not cover these hosts. Deliberate scope, tracked in #160 — not an
#      omission to "fix" by copying the block across without the LAN endpoint and
#      the VM credentials it needs;
#   5. NO throttle_vector_own transform (#153). That bounds the container's
#      self-ingestion feedback loop; a native agent is not reading its own stderr
#      back through docker_logs, so there is no loop here to bound. On
#      n5pro_docker, which DOES collect docker logs, `vector` is not a container
#      at all — it is a systemd unit — so its own output never enters that source.
# Everything else — every VRL line, every comment explaining WHY a coercion is
# defaulted rather than fallible — was copied across verbatim rather than
# "improved", because a difference between the two files is a difference in the
# stored record schema and nothing would report it.
#
# Unifying the two into one templated source is a follow-up issue, not this change.

# Data directory for buffers. Created by the .deb's preinst as vector:vector.
data_dir: "/var/lib/vector"

# Global VRL timezone. The package-audit timestamps (#154) carry no zone marker
# and parse through this. Pinned rather than left on the default `local`: on the
# container twin of this file that default silently resolves to UTC (distroless,
# no tzdata) and skews every pkg record by 7-8 hours, and a native agent that
# agreed with the container only by accident of the host having tzdata is not a
# property worth relying on. `timezone` comes from group_vars/all and matches
# each host's own zone — change them together.
# Only zone-less parse_timestamp calls read this: parse_host's RFC5424 timestamps
# carry their own offset and are untouched.
timezone: "{{ timezone }}"

# Sources - Where logs come from
sources:
  # Vector's own telemetry (#160), mirroring what #151 gave the container agent on
  # eq12_docker. Without it this host can be losing a FRACTION of its events —
  # a VRL remap abort, a filling disk buffer, a sink dropping batches — with every
  # existing check still green: the per-host ingest-stalled rule and this role's
  # end-to-end assert both detect only TOTAL absence.
  #
  # internal_metrics tags by Vector's detected hostname and Vector honours
  # VECTOR_HOSTNAME over the OS hostname; templates/vector.env.j2 sets it to
  # inventory_hostname, so these series carry host="eq12" / "n5pro" /
  # "n5pro_docker" alongside the container's host="eq12_docker".
  #
  # 60s, not the 1s default: these land in a 5y-retention TSDB and per-second
  # scrapes of hundreds of internal series buy nothing.
  vector_metrics:
    type: internal_metrics
    scrape_interval_secs: 60

{% if vector_agent_docker_logs | bool %}
  # Docker container logs. Present only on hosts where Docker runs; the `vector`
  # user is added to the `docker` group by this role so it can read the socket.
  docker_logs:
    type: docker_logs
    docker_host: "unix:///var/run/docker.sock"
    # No include/exclude filters - collect all containers by default
    # This ensures you don't miss logs when adding new services

{% endif %}
  # Host system logs, RFC5424 side-stream.
  #
  # NOT /var/log/syslog + /var/log/auth.log: Debian writes those in
  # RSYSLOG_FileFormat, which carries no PRI header, so facility and severity are
  # unrecoverable from them and every host record had to be hardcoded
  # `level: info` (#143). /var/log/structured.log is the SAME messages re-emitted
  # in RFC5424 by /etc/rsyslog.d/40-vector-structured.conf (deployed by
  # roles/rsyslog_structured, which this role includes before templating this
  # file), whose <PRI> header carries facility*8+severity.
  #
  # syslog and auth.log must stay OUT of this list: the drop-in's `*.*` selector
  # is Debian's `*.*;auth,authpriv.none` (syslog) plus auth,authpriv (auth.log),
  # so tailing them as well would ingest every host event twice.
  #
  # /var/log/kern.log is deliberately absent HERE TOO, and for a different reason
  # than on eq12_docker. That host cannot have one (unprivileged LXC, no kernel
  # ring buffer). This host DOES have one — but the `*.*` selector above already
  # carries the `kern` facility into structured.log, so adding kern.log as a second
  # source would double-ingest every kernel line. Kernel and OOM-kill events reach
  # VictoriaLogs from this host precisely because of that selector, not because of
  # a kern.log source. Do not "fix" this by adding one.
  host_syslog:
    type: file
    include:
      - /var/log/structured.log
    # read_from: beginning, and NO ignore_older_secs (#143 item 4). The old
    # `end` + `ignore_older_secs: 600` pair made any Vector outage longer than ten
    # minutes a permanent hole even though the file on disk was intact the whole
    # time — exactly what the wedged-buffer runbook recovers from
    # (docs/solutions/integration-issues/vector-wedged-disk-buffer-reset.md).
    # Cost, accepted: after a buffer reset (which wipes checkpoints) this file is
    # re-read from its start, so up to one logrotate period of duplicates. Bounded
    # by /etc/logrotate.d/vector-structured (weekly, rotate 4).
    read_from: beginning

  # Package-change audit trail (#143 item 7). Not syslog-shaped and not written
  # through rsyslog, so these files reach VictoriaLogs only by being tailed
  # directly. This is the half of #134 that #99 was actually about: with
  # `Unattended-Upgrade::SyslogEnable "true"` the RUN RESULT goes through rsyslog
  # (and therefore through structured.log, with a real severity), while the verbose
  # detail stays in these files. Both paths are wanted.
  #
  # /var/log/unattended-upgrades is `drwxr-x--- root adm` with 0644 files, and the
  # .deb's postinst puts the `vector` user in `adm`, so these are readable without
  # this role widening anything.
  host_pkg_logs:
    type: file
    include:
      - /var/log/dpkg.log
      - /var/log/apt/history.log
      - /var/log/unattended-upgrades/unattended-upgrades.log
      - /var/log/unattended-upgrades/unattended-upgrades-dpkg.log
    read_from: beginning

# Transforms - Process and enrich logs
transforms:
{% if vector_agent_docker_logs | bool %}
  # Parse Docker logs and add metadata
  parse_docker:
    type: remap
    inputs:
      - docker_logs
    source: |
      # Add standard fields for filtering/grouping
      .source = "docker"

      # NOT get_hostname!(): on the container this returned the CONTAINER ID, which
      # is not a host and changed on every recreate — churning _stream_id in
      # VictoriaLogs and making per-host alerting impossible (#143). A native agent
      # would return the OS hostname instead (n5pro-docker, pve), which is a SECOND
      # hand-maintained mapping away from the name the inventory and the alert rules
      # use. VECTOR_HOSTNAME is Ansible's inventory_hostname, templated into
      # /etc/vector/vector.env and read by systemd's EnvironmentFile. `host` is set
      # to the same value because VictoriaLogs stores BOTH keys and both were wrong
      # before.
      .hostname = "${VECTOR_HOSTNAME}"
      .host = "${VECTOR_HOSTNAME}"

      # Defaulted, not `string!()`. A fallible-abort coercion aborts the whole VRL
      # program, and an aborted remap DROPS the event: drop_on_abort defaults true,
      # reroute_dropped defaults false, so there is no dead-letter and no exported
      # counter — the event simply never existed. Unreachable today (docker_logs
      # always sets container_name), but "unreachable by construction" is exactly
      # the claim that ages badly, and a visible "unknown" beats a vanished event.
      .container_name = to_string(.container_name) ?? "unknown"

      # Docker gives us no severity; the container's own line may contain one but
      # parsing arbitrary application formats is out of scope here.
      .level = "info"

{% endif %}
  # Parse host system logs (RFC5424 from /var/log/structured.log)
  parse_host:
    type: remap
    inputs:
      - host_syslog
    source: |
      .source = "host"
      .hostname = "${VECTOR_HOSTNAME}"
      .host = "${VECTOR_HOSTNAME}"

      # `?? {}` rather than a fallible assignment: parse_syslog's error branch
      # returns null, and indexing null is a VRL compile error. An empty object is
      # the "did not parse" sentinel checked immediately below.
      parsed = parse_syslog(to_string(.message) ?? "") ?? {}
      if length(parsed) > 0 {
        # The whole point of the RFC5424 side-stream: a real severity per record,
        # one of emerg/alert/crit/err/warning/notice/info/debug. Kept as a plain
        # field, NOT a Loki label — VictoriaLogs makes JSON body fields queryable
        # (`level:err` works), so labelling it would multiply _stream cardinality
        # by eight for nothing.
        .level = parsed.severity
        .facility = parsed.facility
        .appname = parsed.appname
        .procid = parsed.procid
        # This host's own OS hostname, preserved because `hostname` now carries the
        # Ansible inventory name instead. On eq12 these two genuinely differ: the
        # OS/Proxmox node name is `pve` and the inventory name is `eq12`.
        .syslog_hostname = parsed.hostname
        # A real timestamp VALUE, and deliberately not format_timestamp!().
        # format_timestamp! returns a String; the loki sink matches the timestamp
        # field only on the timestamp type and silently falls back to Utc::now()
        # on anything else (and strips the key from the body — remove_timestamp
        # defaults true). So the string form is a no-op that CANNOT be detected
        # from process state: vector starts, ships, and every _time is ingest
        # time. Do not "simplify" this back to a formatted string.
        .timestamp = parsed.timestamp
        # Drop the RFC5424 header from the body — its parts are now fields.
        .message = parsed.message
      } else {
        # "unknown", NOT "info". Fabricating a severity is the exact defect #143
        # exists to remove, and an unparseable line is MORE likely to be a
        # malformed emergency than a routine one — defaulting it to info would hide
        # precisely the record worth seeing. `parse_failed:*` is queryable.
        .level = "unknown"
        .parse_failed = "syslog"
        # Same correction as parse_pkg's else branch, found by the same probe: the
        # file source pre-set .timestamp to the READ time, so a line that fell
        # through the syslog parse kept it and was stamped
        # timestamp_source:"event" — the exact case this field exists to expose,
        # labelled as if it had a real event time. Delete so finalize stamps now()
        # and marks "ingest". (`parse_failed` already flags these independently;
        # this makes the provenance field agree with it instead of contradicting
        # it.)
        del(.timestamp)
      }

  # Package-change audit trail. dpkg/apt/unattended-upgrades write their own line
  # formats with no severity, but they DO carry in-line timestamps, and until #154
  # every record here kept the file source's INGESTION time — the whole backfill
  # landed inside a 3.8 ms window while the lines carried dates days older, and a
  # buffer reset re-stamped up to a year of package history with the reset date.
  # Four formats, measured on the live files, not assumed:
  #   dpkg.log:                     "2026-08-16 06:19:24 status installed ..."
  #   unattended-upgrades.log:      "2026-08-16 06:19:22,919 INFO ..." (the first
  #                                 19 chars parse identically; the ,millis are
  #                                 sliced off, not parsed)
  #   apt/history.log:              "Start-Date: 2026-08-16  06:19:24" (TWO spaces)
  #   unattended-upgrades-dpkg.log: "Log started: 2026-08-16  06:19:23" (two too)
  # Lines with no leading timestamp (apt history block bodies, dpkg progress
  # spam) keep ingest time and stay queryable as timestamp_source:"ingest" — the
  # finalize transform stamps that provenance, unchanged.
  # .timestamp must be a timestamp TYPE: the loki sink honours it only then and
  # silently falls back to now() on a string — the same trap parse_host documents.
  # Every coercion defaulted, none fallible-abort (an aborted remap DROPS the
  # event: no counter, no dead-letter). `?? null` and an explicit null test rather
  # than a fallible assignment, for the same reason parse_host uses `?? {}`.
  # The formats carry NO zone marker, so they resolve through the global
  # `timezone` pinned at the top of this file. That pin is load-bearing — see the
  # comment there.
  parse_pkg:
    type: remap
    inputs:
      - host_pkg_logs
    source: |
      .source = "pkg"
      .hostname = "${VECTOR_HOSTNAME}"
      .host = "${VECTOR_HOSTNAME}"
      .level = "info"

      msg = to_string(.message) ?? ""
      # dpkg.log / unattended-upgrades*.log: leading "YYYY-MM-DD HH:MM:SS"
      ts = parse_timestamp(slice(msg, 0, 19) ?? "", "%Y-%m-%d %H:%M:%S") ?? null
      if ts == null {
        # apt/history.log Start-Date:/End-Date: blocks and the dpkg-log
        # "Log started:/Log ended:" markers — note the variable run of spaces.
        parts = parse_regex(msg, r'^(?:Start-Date|End-Date|Log started|Log ended):\s+(?P<d>\d{4}-\d{2}-\d{2})\s+(?P<t>\d{2}:\d{2}:\d{2})') ?? {}
        if length(parts) > 0 {
          # No `??` on these two: parse_regex captures are strings, so to_string
          # here is infallible and VRL rejects the coalescing as unnecessary (E651).
          joined = to_string(parts.d) + " " + to_string(parts.t)
          ts = parse_timestamp(joined, "%Y-%m-%d %H:%M:%S") ?? null
        }
      }
      if ts != null {
        .timestamp = ts
      } else {
        # DELETE IT, do not just leave it. Vector's `file` source has ALREADY set
        # .timestamp to the READ time, so finalize's `!is_timestamp` fallback can
        # never fire on this branch and every pkg record was stamped
        # timestamp_source:"event" while carrying ingest time — measured 2026-08-22,
        # 1672 of them, all lying, for the whole life of the field. That made the one
        # field designed to tell line-time from ingest-time useless for the one
        # source where the distinction is real. Deleting the key lets finalize stamp
        # now() and mark "ingest" honestly.
        del(.timestamp)
      }

  # Normalise the timestamp and build the Loki label set
  finalize:
    type: remap
    inputs:
{% if vector_agent_docker_logs | bool %}
      - parse_docker
{% endif %}
      - parse_host
      - parse_pkg
    source: |
      # Stamp now() ONLY when nothing upstream supplied a timestamp. Overwriting
      # EVERY event with now() unconditionally is what made host records carry
      # ingest time instead of the time in the line (#143); precision is the tell
      # (nanoseconds = now(), exactly six digits = rsyslog's microseconds).
      #
      # Since #154 it also covers the package-audit branch: parse_pkg parses each
      # line's own in-line timestamp, so a pkg record reaching here already carries
      # one and takes the "event" branch below. Before that those records all
      # landed in a millisecond-wide window at first-tail time while their _msg
      # values carried dates going back days. The fallback still matters for pkg:
      # apt history block bodies and dpkg progress lines genuinely have no
      # timestamp and correctly keep ingest time.
      #
      # .timestamp_source records the provenance so it is QUERYABLE: a record
      # reading "ingest" carries no time of its own — a host line that fell through
      # the syslog parse, or a pkg line with no leading timestamp. That claim was
      # FALSE until #154: the upstream sources pre-set .timestamp (file to the READ
      # time), so `!is_timestamp` never fired and every record read "event". The
      # two `del(.timestamp)` calls above are what make this branch reachable.
      ts = .timestamp
      if !is_timestamp(ts) {
        .timestamp = now()
        .timestamp_source = "ingest"
      } else {
        .timestamp_source = "event"
      }

      # Map message field to _msg for VictoriaLogs
      # VictoriaLogs requires _msg field: https://docs.victoriametrics.com/victorialogs/keyconcepts/#message-field
      if exists(.message) {
        ._msg = del(.message)
      }

      # Loki labels, built per-event, consumed by the sink's `"*"` expansion.
      # Host and pkg events genuinely have no container_name, and templating a
      # label that cannot render made Vector log a warning for EVERY such event —
      # 88% of its own stderr in 30 minutes (#143 item 3). A conditional object has
      # nothing to fail to render.
      # Do NOT invent a synthetic container_name for host events: that puts a fake
      # value in a real field.
      # Every coercion defaulted, none fallible-abort. `.source` especially: an
      # abort in an upstream remap leaves the event unmodified, so `.source` would
      # be absent here, `to_string!()` would abort a SECOND time and the event is
      # dropped silently — or, surviving, the sink's "*" expansion would find no
      # loki_labels and write an entry with an EMPTY label set. A defaulted
      # "unknown" surfaces the anomaly as a queryable label instead of vanishing
      # the record.
      labels = {
        "source": to_string(.source) ?? "unknown",
        "hostname": to_string(.hostname) ?? "unknown"
      }
      if exists(.container_name) {
        labels = set(labels, ["container_name"], to_string(.container_name) ?? "unknown") ?? labels
      }
      .loki_labels = labels

# Sinks - Where logs go
sinks:
  # Ship Vector's own telemetry to VictoriaMetrics (#160). Same protocol and auth
  # shape the container agent and telegraf already use, so the write path is proven
  # rather than new. Vector's default namespace for this sink is "vector", so series
  # arrive as vector_component_errors_total etc. — the four vector-health alert
  # rules aggregate by (component_id) with no host selector, so these join them
  # automatically.
  vector_metrics_out:
    type: prometheus_remote_write
    inputs:
      - vector_metrics
    endpoint: {{ victoriametrics_ingest_endpoint }}
    auth:
      strategy: basic
      user: "${VM_AUTH_USERNAME}"
      password: "${VM_AUTH_PASSWORD}"
    # Vector probes this endpoint at startup and expects 200; VictoriaMetrics
    # answers the remote-write path with 204 No Content, so the probe logs
    # `Healthcheck failed. error=Unexpected status: 204 No Content` on EVERY start
    # while the sink is working perfectly — measured on all three agents, with the
    # series arriving in VM at the same moment (#160). The healthcheck is
    # non-fatal and gates nothing, so its only effect was a standing ERROR that
    # says the sink is broken when it is not, which is how operators learn to skim
    # errors. Disabled deliberately, NOT because health does not matter: health is
    # proven by the data instead, per-host, by obs-vector-metrics-absent
    # (min by (host) (lag(vector_uptime_seconds[24h]))) — an assertion about
    # ARRIVAL, which a startup probe could never make anyway.
    healthcheck:
      enabled: false

  # Send to VictoriaLogs on eq12_docker, over the LAN.
  #
  # Cleartext HTTP with basic auth, same as every other internal hop in this
  # homelab. It is stated in roles/services/observability/README.md rather than
  # quietly shipped; TLS on the ingest path is a follow-up issue.
  victorialogs:
    type: loki
    inputs:
      - finalize
    endpoint: {{ victorialogs_ingest_endpoint }}
    auth:
      strategy: basic
      user: "${VL_AUTH_USERNAME}"
      password: "${VL_AUTH_PASSWORD}"
    encoding:
      codec: json
    # Vector 0.57 requires templated fields to carry a literal prefix ("template
    # confinement"), so that event data cannot resolve outside an intended
    # namespace — on sinks that template a path or key, that means arbitrary
    # writes. Here the templated field is a Loki label OBJECT, not a path, and its
    # contents are built by the `finalize` remap above from a literal, the Docker
    # daemon's container_name and an Ansible-supplied env var — none
    # attacker-controlled. This flag also covers the `"*"` dynamic-label expansion
    # below, whose key names come from the same object. Opting out keeps the
    # existing label values intact; adding a prefix would rewrite every stored
    # label and break existing Grafana queries. Scoped to this sink only.
    dangerously_allow_unconfined_template_resolution: true
    labels:
      # Dynamic label expansion: every key of the `loki_labels` object becomes a
      # Loki label. The Jinja escapes are only so this templated file emits the
      # literal Vector template `{{ '{{ loki_labels }}' }}`.
      "*": "{{ '{{ loki_labels }}' }}"
    # Strips the field the label template referenced (`loki_labels`) from the JSON
    # body, so the object is not also stored as duplicate keys on every record.
    remove_label_fields: true
    compression: gzip
    out_of_order_action: accept
    batch:
      max_bytes: 1048576      # 1MB batches (good balance)
      timeout_secs: 5         # Flush every 5 seconds
    buffer:
      type: disk
      max_size: 268435488     # 256MB disk buffer
      when_full: block
