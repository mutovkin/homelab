# {{ ansible_managed }} — roles/telegraf_agent (#186)
# systemd EnvironmentFile, parsed by systemd ONLY (never a shell). Parser
# semantics, measured in #134: one surrounding pair of double quotes is stripped,
# contents taken literally — `$` and backticks are safe; `"`, backslash, CR, LF
# are not, and the role asserts the credentials contain none of those. The
# environ-digest assert in tasks/main.yml is the real guarantee.
VM_AUTH_USERNAME="{{ vault_vm_auth_username }}"
VM_AUTH_PASSWORD="{{ vault_vm_auth_password }}"
