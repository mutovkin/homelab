# {{ ansible_managed }} — roles/telegraf_agent (#186)
# Host metrics agent for the PHYSICAL Proxmox hosts (eq12, n5pro). The container
# telegraf on eq12_docker (roles/services/observability) is a different animal —
# it also carries the TrueNAS graphite listener and Grafana scrape; this file is
# deliberately host-vitals only.

[global_tags]
  environment = "homelab"
  location = "home"

[agent]
  interval = "60s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "5s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = "1s"
  # host = inventory_hostname — the fleet-wide convention (#178). Templated
  # LITERALLY rather than via ${TELEGRAF_HOSTNAME}: an unset env var is stamped
  # as the literal string `${TELEGRAF_HOSTNAME}` while the agent stays healthy
  # (measured in #178). Templating removes that failure class for the native
  # agents; the deploy still proves the label end-to-end by querying the store.
  hostname = "{{ inventory_hostname }}"
  omit_hostname = false

# VictoriaMetrics remote write — same shape, auth and reasoning as the container
# telegraf's output block; credentials come from /etc/telegraf/telegraf.env via
# the systemd drop-in. Telegraf 1.38+ errors loudly on an UNSET ${VAR} in config,
# so a missing env file fails the unit rather than shipping unauthenticated.
[[outputs.http]]
  url = "{{ victoriametrics_ingest_endpoint }}"
  data_format = "prometheusremotewrite"
  timeout = "10s"
  # Evict pooled connections BEFORE VictoriaMetrics closes them (#208). VM runs with
  # the default -http.idleConnTimeout=1m0s and telegraf's flush cadence is exactly
  # 60 s, so with the default (0 = keep idle connections forever) EVERY keep-alive
  # reuse raced the server's idle deadline. Measured 2026-08-29 from a three-point
  # capture: all 16 at-risk reuses across both hosts landed within +-5 ms of the
  # 60.000 s deadline, and the three that missed it by more than ~+0.45 ms died as
  # EOF / RST / broken pipe (one on n5pro at +599 us, two on eq12, the first at
  # +534 us; the server's FIN went out 22 us AFTER the doomed request arrived, so
  # no client could have seen it coming).
  # Not an n5pro problem — eq12 failed MORE often during that capture; the per-host
  # rate swings in multi-hour epochs as the two 60 s timers drift past each other.
  # 45 s evicts before the 50 s and 60 s reuses (the only dangerous ones) with
  # headroom, while still pooling the 10 s split-flush pair. Client-side eviction is
  # race-free by construction: Go's idle timer takes the pool mutex and skips the
  # close if a request has already claimed the connection.
  #
  # THIS VALUE IS COUPLED TO THE SERVER'S, WHICH THE REPO DOES NOT PIN. The invariant
  # is one-sided: strictly below VictoriaMetrics' idle timeout, with margin. That
  # timeout is currently an UNDECLARED DEFAULT — roles/services/observability's
  # compose.yaml passes no -http.idleConnTimeout and runs the `latest` image — so the
  # coupling breaks silently if someone sets that flag BELOW 45 s or upstream lowers
  # its default. Raising it, or setting it explicitly to a larger value, needs no
  # change here. The regression is invisible in the journal for hours at a time
  # (see the epochs above), so it will not announce itself.
  idle_conn_timeout = "45s"
  username = "${VM_AUTH_USERNAME}"
  password = "${VM_AUTH_PASSWORD}"
  [outputs.http.headers]
    Content-Type = "application/x-protobuf"
    Content-Encoding = "snappy"
    X-Prometheus-Remote-Write-Version = "0.1.0"

[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs"]

# Meaningful on physical hosts (the container config disables it for LXC reasons
# that do not apply here): real NVMe queue/latency/throughput per device.
[[inputs.diskio]]
  skip_serial_number = true

[[inputs.kernel]]

[[inputs.mem]]

[[inputs.processes]]

[[inputs.swap]]

[[inputs.system]]
  fieldexclude = ["uptime_format"]  # string field, incompatible with prometheus

[[inputs.net]]

[[inputs.netstat]]

# ZFS kstats: ARC size/hits/misses etc from /proc/spl/kstat/zfs — both hosts are
# root-on-ZFS (rpool). Dataset USAGE arrives via inputs.disk (mounted datasets).
[[inputs.zfs]]

# The measured lm-sensors surface (#186, 2026-08-24):
#   eq12:  coretemp (Package + Core 0..3, max/crit), acpitz, nvme Composite
#   n5pro: k10temp Tctl (ONE value — no per-core on this Zen5; may carry an AMD
#          offset, so no threshold goes on it without a second source),
#          spd5118 x2 (DDR5 DIMM temps), amdgpu (edge temp, power1), nic1 (PHY+MAC),
#          r8169 (NIC), acpitz, nvme Composite
# remove_numbers = false is LOAD-BEARING: the default true strips digits from
# feature names, which would merge eq12's core_0..core_3 into one series.
[[inputs.sensors]]
  remove_numbers = false
{#
  Gated on the EXCLUSION list, not on telegraf_agent_forbidden_test_output. Those
  are two different jobs that happened to hold the same value: this one shapes the
  config (what the sensors input must drop at the source), the other is the proof
  list checked against `telegraf --test`'s output (what must then be absent).
  Splitting them was #186's review round — see defaults/main.yml. The rendering is
  byte-identical to the hardcoded pair it replaced, verified by diff.
#}
{% if telegraf_agent_sensors_tagdrop_features | length > 0 %}
  # Fabricated zeros, excluded at the source (CLAUDE.md: gauges skip on unknown):
  # amdgpu vddgfx/vddnb read 0.000 V on n5pro — unsupported readings, not
  # measurements. The deploy asserts these never appear in `telegraf --test`.
  [inputs.sensors.tagdrop]
    feature = [{{ telegraf_agent_sensors_tagdrop_features | map('to_json') | join(', ') }}]
{% endif %}

# NVMe SMART for the root disks — wear, spare, power-on-hours, media errors: the
# signal #183 wanted and could not get from TrueNAS, obtainable here. smartctl is
# already installed on both hosts (measured 2026-08-24), and the unit reaches the
# NVMe admin ioctl through AMBIENT CAP_DAC_OVERRIDE + CAP_SYS_ADMIN rather than
# root, sudo (absent here) or setuid — see the drop-in for the measured staircase.
# use_sudo stays off for that reason. Ambient caps survive NoNewPrivileges, so the
# trap that cost the container telegraf its ping metrics does not arise; the
# deploy proves it against this input's OWN output rather than assuming it.
[[inputs.smart]]
  path_smartctl = "/usr/sbin/smartctl"
  attributes = true
{% if telegraf_agent_acpi_fan_state | bool %}

# eq12 only. BINARY ACPI fan state (0/1) — NOT a fan speed, and not this board's
# tachometer. Under the DEFAULT driver set the board exposes no fan*_input and no
# pwm* (measured #186); a forced binding of the stock in-kernel it87 module DOES
# read two real tachometers (measured 2026-08-25), but that is unpersisted, not
# collected, and pending an operator decision — see docs/eq12.md.
# Never graph or label this series as RPM.
# Array argv and log_stderr for the same two reasons as the RAPL block below.
# NOTE the deprecation is NOT about spaces: what 1.39.0 deprecated is the FLAT
# element form `commands = ["cmd"]` as such, and this single-token command warned
# on every start exactly like the RAPL one with its argument (measured on eq12).
# A future third exec input with a one-word command needs the nested form too.
[[inputs.exec]]
  commands = [["/usr/local/lib/telegraf/acpi_fan_state.sh"]]
  timeout = "5s"
  data_format = "influx"
  log_stderr = true
{% endif %}
{% if telegraf_agent_rapl_power | bool %}

# RAPL package power, in WATTS (#194). Both hosts load intel_rapl_msr +
# intel_rapl_common — yes, the AMD box too — and expose /sys/class/powercap;
# `energy_uj` is `-r-------- root root` and the unit reaches it through ambient
# CAP_DAC_OVERRIDE, not root (see the drop-in).
#
# WHY NOT [[inputs.intel_powerstat]] — the negative belongs HERE, where the next
# person would "simplify" to the plugin. Measured 2026-08-25 with
# `telegraf --test` under the real unit user and capabilities:
#   * n5pro — the plugin will not initialise: "failed to initialize metric
#     fetcher interface: host processor is not supported". It cannot serve this
#     machine at all.
#   * eq12 — it runs, and its FIRST gather emits
#     current_power_consumption_watts=826963607.79: a first-sample artefact with
#     no prior read to delta against, i.e. a garbage spike at every restart.
# Running the plugin on eq12 and the script on n5pro would export two metric
# names for one signal — the coretemp/k10temp divergence trap. One script, both
# hosts.
#
# The script converts to watts AT THE SOURCE because these counters wrap fast
# (65.5 kJ on n5pro: ~3 h idle, ~20 min loaded), so a rate() over the raw
# counter would spike negative at every rollover. Each sample is a ~1 s
# instantaneous snapshot taken once per 60 s interval, NOT a 60 s average.
# The script runs ~1 s; timeout is 5 s.
#
# Arguments are the domains to EXCLUDE (n5pro: `core` — measured by load
# PLACEMENT to cover CPU0 alone, not the package's cores; eq12's same-named
# domain passes that test and is exported). The role asserts these names are
# bare tokens before templating them into this TOML string.
# RAPL is PACKAGE power, never wall power.
#
# ARGV AS A NESTED ARRAY. telegraf deprecated the FLAT element form
# (`commands = ["cmd"]`) in 1.39.0 and REMOVES it in 1.45.0 — measured, both
# hosts logged `DeprecationWarning: ... Use array syntax instead` on every start,
# including for a command with NO arguments and no spaces. The deprecation is of
# the value FORM, not of embedded whitespace; do not conclude a one-word command
# is exempt. Past 1.45.0 this input stops loading, so the form written here is
# the one that survives the next telegraf_agent_version bump.
#
# A pinned dependency's own deprecation warnings are the bump-blocker list: read
# the journal of the version you pinned, not just the release notes of the next.
#
# log_stderr because the script's diagnostics are otherwise THROWN AWAY on the
# only path that produces them. inputs.exec surfaces stderr by itself only when
# the command exits NON-ZERO; a partial failure (one domain rejected by the
# plausibility ceiling, or a zone that vanished mid-sample) still exits 0 because
# the other domains are fine. Without this the domain silently disappears and the
# `journalctl -u telegraf | grep -i exec` that the alert runbook and the deploy
# assert both tell the operator to run returns NOTHING.
[[inputs.exec]]
  commands = [[{{ (['/usr/local/lib/telegraf/rapl_power.sh'] + telegraf_agent_rapl_exclude_domains) | map('to_json') | join(', ') }}]]
  timeout = "5s"
  data_format = "influx"
  log_stderr = true
{% endif %}
